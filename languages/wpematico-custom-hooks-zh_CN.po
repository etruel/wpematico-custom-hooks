#. translators: 1: parser message, 2: line number
#: includes/wpematicohk_sintax.php:133
msgid "Parse error: %1$s on line %2$d"
msgstr "解析错误：%1$s，位于第 %2$d 行"

#. translators: %s: error message
#: includes/wpematicohk_sintax.php:140
msgid "The code could not be checked: %s"
msgstr "无法检查代码：%s"

#. translators: %s: parameter name
#: includes/wpematicohk_sintax.php:74
msgid "The parameter %s is named twice in the same function. PHP refuses to compile that, and the error cannot be caught, so it would take the whole site down."
msgstr "参数 %s 在同一个函数里出现了两次。PHP 拒绝编译这种代码，而且该错误无法捕获，会让整个站点崩掉。"

#. translators: 1: function name, 2: the other hook's name
#: includes/wpematicohk_sintax.php:86
msgid "The function %1$s is already declared in the code for %2$s. Two hooks cannot declare the same function name — rename one of them."
msgstr "函数 %1$s 已在 %2$s 的代码中声明。两个钩子不能声明同名的函数 — 请给其中一个改名。"

#. translators: %s: function name
#: includes/wpematicohk_sintax.php:98
msgid "The function %s already exists in WordPress or in another plugin. Declaring it again would be a fatal error — pick a different name."
msgstr "函数 %s 已存在于 WordPress 或另一个插件中。再声明一次会是致命错误 — 请换一个名字。"

