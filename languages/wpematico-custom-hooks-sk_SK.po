msgstr "Vyber hook, na ktorom chceš spúšťať kód, a stlač Pridať funkciu: nižšie sa otvorí editor s hlavičkou už napísanou za teba. Šablóna mení len to, ako ten editor vyzerá."

#: includes/wpematicohk_settings.php:325
msgid "Select theme for the editor"
msgstr "Vyber šablónu pre editor"

#: includes/wpematicohk_settings.php:327
msgid "Colors Scheme"
msgstr "Farebná schéma"

