#. translators: 1: parser message, 2: line number
#: includes/wpematicohk_sintax.php:133
msgid "Parse error: %1$s on line %2$d"
msgstr "Chyba pri analýze: %1$s na riadku %2$d"

#. translators: %s: error message
#: includes/wpematicohk_sintax.php:140
msgid "The code could not be checked: %s"
msgstr "Kód sa nedal skontrolovať: %s"

#. translators: %s: parameter name
#: includes/wpematicohk_sintax.php:74
msgid "The parameter %s is named twice in the same function. PHP refuses to compile that, and the error cannot be caught, so it would take the whole site down."
msgstr "Parameter %s je v tej istej funkcii pomenovaný dvakrát. PHP to odmieta preložiť a takú chybu nemožno zachytiť, takže by zhodila celý web."

#. translators: 1: function name, 2: the other hook's name
#: includes/wpematicohk_sintax.php:86
msgid "The function %1$s is already declared in the code for %2$s. Two hooks cannot declare the same function name — rename one of them."
msgstr "Funkcia %1$s je už deklarovaná v kóde pre %2$s. Dva hooky nemôžu deklarovať rovnaký názov funkcie — jeden z nich premenuj."

#. translators: %s: function name
#: includes/wpematicohk_sintax.php:98
msgid "The function %s already exists in WordPress or in another plugin. Declaring it again would be a fatal error — pick a different name."
msgstr "Funkcia %s už existuje vo WordPresse alebo v inom plugine. Deklarovať ju znovu by bola fatálna chyba — vyber iný názov."

#. translators: 1: required WPeMatico version, 2: installed WPeMatico version
#: wpematico_custom-hooks.php:217
msgid "WPeMatico Custom Hooks needs WPeMatico %1$s or newer to run. You have %2$s installed, so the Hooks screen is disabled until you update."
msgstr "WPeMatico Custom Hooks potrebuje na svoju prácu WPeMatico %1$s alebo novší. Máš nainštalovaný %2$s, takže obrazovka Hooks zostáva vypnutá, kým neaktualizuješ."
